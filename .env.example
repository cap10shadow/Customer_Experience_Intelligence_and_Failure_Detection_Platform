# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=operational_intelligence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Service Ports
GATEWAY_SERVICE_PORT=8000
INGESTION_SERVICE_PORT=8001
NLP_SERVICE_PORT=8002
ANOMALY_SERVICE_PORT=8003
ROOT_CAUSE_SERVICE_PORT=8004
BUSINESS_IMPACT_SERVICE_PORT=8005
RECOMMENDATION_SERVICE_PORT=8006
COPILOT_SERVICE_PORT=8007
EVALUATION_SERVICE_PORT=8008
FRONTEND_PORT=3000

# Phase 11 Batch 1 -- Observability Foundation. Prometheus is the only
# newly host-published port this batch adds (Loki/Promtail are
# internal-only, matching every backend service except gateway_service).
PROMETHEUS_PORT=9090

# Phase 11 Batch 2 -- Distributed Tracing. OTLP_EXPORTER_ENDPOINT matches
# docker-compose.yml's otel-collector service name/gRPC port; override to
# a local collector address for non-Docker local development the same
# way POSTGRES_HOST already is. TRACING_ENABLED=false lets a local run
# with no collector available opt out entirely.
TRACING_ENABLED=true
OTLP_EXPORTER_ENDPOINT=otel-collector:4317

# Phase 11 Batch 4 -- Grafana. Host port 3001, not 3000 (F1: the
# frontend already owns 3000) -- container stays on Grafana's own
# default internal port. Admin password is a prototype-scope default
# (Grafana ships with its own admin flow, not integrated with platform
# auth -- Phase 11 architecture §5), not a real secret; override in a
# real deployment via a non-tracked .env.
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_PASSWORD=admin

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Downstream service URLs. Primarily consumed by gateway_service; also
# consumed by business_impact_service (Part 6) to deliver the
# BusinessImpactCompleted event to recommendation_service and
# evaluation_service. Docker-network defaults -- match docker-compose.yml's
# service names, the same pattern already used by vite.config.ts's dev proxy.
INGESTION_SERVICE_URL=http://ingestion_service:8001
NLP_SERVICE_URL=http://nlp_service:8002
ANOMALY_SERVICE_URL=http://anomaly_service:8003
ROOT_CAUSE_SERVICE_URL=http://root_cause_service:8004
BUSINESS_IMPACT_SERVICE_URL=http://business_impact_service:8005
RECOMMENDATION_SERVICE_URL=http://recommendation_service:8006
COPILOT_SERVICE_URL=http://copilot_service:8007
EVALUATION_SERVICE_URL=http://evaluation_service:8008

# Gateway CORS -- comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Phase 13 Batch 4 -- the shared internal service-to-service credential
# (backend/shared/security/internal_auth.py, AD-5). Sent as the
# X-Internal-Secret header by business_impact_service (event delivery)
# and gateway_service (the recommendation-decision PATCH and Copilot
# routes); validated by recommendation_service, evaluation_service, and
# copilot_service. This default is an obviously-fake development value,
# not a real secret -- rotate before any real deployment (§19 of the
# frozen architecture), and never set it via a VITE_* variable.
INTERNAL_SERVICE_SECRET=dev-only-insecure-internal-secret-change-in-production

# Phase 12 Batch 3 -- Copilot LLM provider (docs/architecture/phase-12/
# PHASE_12_ARCHITECTURE.md §24). No provider is configured by default --
# copilot_service falls back to an honest "no language model configured"
# answer (NullLLMProvider) when LLM_PROVIDER is unset, exactly matching
# this repository's actual state (verified: no LLM credentials exist
# anywhere). Set LLM_PROVIDER=openai_compatible and the three values
# below to enable a real provider; never commit a real key here.
LLM_PROVIDER=none
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
